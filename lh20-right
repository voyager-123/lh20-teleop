#!/usr/bin/env bash
set -eo pipefail
workspace_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
hand=right
case "${1:---help}" in
  -h|--help)
    echo "LH20 $hand 固定入口：vision | sdk | status | jog | teleop | check"
    echo "用法：$0 vision [--camera 0 | --self-test]"
    echo "      $0 sdk | status | jog [--slot 1 --delta -5 --return [--execute]]"
    echo "      $0 teleop [--span 20] [--execute]  (已验证左手食指根部随动)"
    echo "右手 vision 仅预览；右手实时控制尚未通过本机实物验证。"
    exit 0 ;;
  vision|sdk|status|jog|teleop)
    for argument in "$@"; do
      case "$argument" in
        --hand|--hand=*) echo "此入口固定为 $hand；请使用另一个左右手入口。" >&2; exit 2 ;;
      esac
    done
    exec "$workspace_dir/lh20" "$@" --hand "$hand" ;;
  *) exec "$workspace_dir/lh20" "$@" ;;
esac
